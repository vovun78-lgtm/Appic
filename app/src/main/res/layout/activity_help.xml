<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        app:popupTheme="@style/PopupMenuDark" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:padding="16dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="32dp">

            <!-- ==================== ЗАГОЛОВОК ==================== -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Руководство пользователя"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="?attr/textPrimaryColor"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Полное описание всех возможностей приложения"
                android:textSize="14sp"
                android:textColor="?attr/textSecondaryColor"
                android:layout_marginBottom="24dp" />

            <!-- ==================== СЕКЦИЯ 1: О ПРИЛОЖЕНИИ ==================== -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="?attr/cardBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="1. О приложении"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="?attr/textPrimaryColor"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Это универсальный конструктор для учёта чего угодно. Приложение не привязано к конкретной сфере — вы сами задаёте, что будете учитывать:\n\n• Станки, автомобили, инструменты — для материального учёта.\n• Проекты, задачи, заявки — для работы и планирования.\n• Коллекции книг, фильмов, растений — для личных интересов.\n• Ремонты, прививки, визиты — для истории событий.\n\nВнутри каждого объекта вы ведёте записи с произвольным набором полей, прикрепляете фото, видео и документы. Все данные хранятся только на вашем устройстве — никакой интернет не нужен."
                        android:textSize="14sp"
                        android:textColor="?attr/textSecondaryColor"
                        android:lineSpacingExtra="4dp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ==================== СЕКЦИЯ 2: ПЕРВЫЙ ЗАПУСК ==================== -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="?attr/cardBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="2. Первый запуск (приветствие)"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="?attr/textPrimaryColor"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="При самом первом запуске приложение попросит вас ответить на 6 вопросов — это займёт не больше минуты. Ответы можно изменить позже в настройках через пункт «Переименовать термины».\n\nШаги:\n\n1. Название приложения — как оно будет отображаться в верхней панели. Например: «Мои авто», «Склад», «Мои проекты».\n\n2. Основной объект в единственном числе — что вы будете учитывать. Например: «Станок», «Автомобиль», «Проект».\n\n3. Основной объект во множественном числе. Например: «Станки», «Автомобили», «Проекты».\n\n4. Элемент внутри в единственном числе — что именно записываете о каждом объекте. Например: «Ремонт», «Запись», «Задача».\n\n5. Элемент внутри во множественном числе. Например: «Ремонты», «Записи», «Задачи».\n\n6. Настройка полей — выбор типов для «Заголовка» и «Содержимого», плюс добавление до 10 дополнительных полей. Подробнее — в разделе 6 «Типы полей»."
                        android:textSize="14sp"
                        android:textColor="?attr/textSecondaryColor"
                        android:lineSpacingExtra="4dp"
                        android:layout_marginBottom="12dp" />

                    <!-- Скриншот-заглушка -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="180dp"
                        android:background="@drawable/bg_help_placeholder"
                        android:gravity="center"
                        android:text="📷 [Скриншот: экран приветствия, шаг 1 из 6]"
                        android:textColor="#888888"
                        android:textSize="14sp"
                        android:padding="16dp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ==================== СЕКЦИЯ 3: ГЛАВНЫЙ ЭКРАН ==================== -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="?attr/cardBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="3. Главный экран"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="?attr/textPrimaryColor"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Главный экран — это список всех ваших объектов и групп объектов.\n\nЧто можно делать:\n\n• Нажать на объект — откроется список его записей.\n• Нажать на группу (папку) — откроется список объектов внутри.\n• Долгое нажатие на карточку — открыть меню действий: «Редактировать», «Удалить», «Поделиться», «Сохранить» (экспорт в файл), «Переместить в группу» (только для объектов).\n• Потянуть за ручку слева от карточки — изменить порядок вручную.\n• Перетащить объект на группу — переместить его в эту группу.\n• Красная точка на карточке — есть непрочитанные записи внутри.\n\nКнопки внизу экрана:\n\n• 📁 (слева) — создать новую группу объектов.\n• ➕ (справа) — добавить новый объект."
                        android:textSize="14sp"
                        android:textColor="?attr/textSecondaryColor"
                        android:lineSpacingExtra="4dp"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="180dp"
                        android:background="@drawable/bg_help_placeholder"
                        android:gravity="center"
                        android:text="📷 [Скриншот: главный экран со списком объектов и групп]"
                        android:textColor="#888888"
                        android:textSize="14sp"
                        android:padding="16dp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ==================== СЕКЦИЯ 4: ГРУППЫ ОБЪЕКТОВ ==================== -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="?attr/cardBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="4. Группы объектов"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="?attr/textPrimaryColor"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Группы помогают разложить объекты по категориям. Например: «Гараж», «Офис», «Склад».\n\nВнутри группы:\n\n• Кнопка ➕ (справа) — добавить новый объект сразу в эту группу.\n• Меню (три точки в тулбаре) — переименовать или удалить группу.\n• Долгое нажатие на объект — редактировать, удалить, переместить в другую группу.\n• Потянуть за ручку слева — изменить порядок объектов внутри группы.\n\nВажно: при удалении группы объекты внутри неё не удаляются — они просто становятся «без группы» и появляются в общем списке главного экрана."
                        android:textSize="14sp"
                        android:textColor="?attr/textSecondaryColor"
                        android:lineSpacingExtra="4dp"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="180dp"
                        android:background="@drawable/bg_help_placeholder"
                        android:gravity="center"
                        android:text="📷 [Скриншот: экран группы объектов]"
                        android:textColor="#888888"
                        android:textSize="14sp"
                        android:padding="16dp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ==================== СЕКЦИЯ 5: ЭКРАН ОБЪЕКТА ==================== -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="?attr/cardBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="5. Экран объекта (записи)"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="?attr/textPrimaryColor"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Здесь вы ведёте историю по выбранному объекту. Экран состоит из карточек-записей и карточек-групп записей.\n\nЧто можно делать:\n\n• Нажать на запись — открыть её для просмотра/редактирования.\n• Нажать на группу — открыть список записей внутри.\n• Долгое нажатие на запись — «Редактировать», «Удалить», «Поделиться», «Сохранить» (экспорт одной записи в файл).\n• Долгое нажатие на группу — «Редактировать», «Удалить», «Поделиться», «Сохранить».\n• Потянуть за ручку слева — изменить порядок.\n• Перетащить запись на группу — переместить в эту группу.\n\nКнопки внизу:\n\n• 📁 (слева) — создать новую группу записей.\n• ➕ (справа) — добавить новую запись.\n\nВ карточке записи могут отображаться:\n\n• Заголовок (то, что задали в приветствии).\n• Текст содержимого (если введён).\n• Превью до 2-х дополнительных полей (например, «Рейтинг: ★★★★☆» или «Статус: В работе»).\n• Красная точка — запись непрочитана."
                        android:textSize="14sp"
                        android:textColor="?attr/textSecondaryColor"
                        android:lineSpacingExtra="4dp"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="180dp"
                        android:background="@drawable/bg_help_placeholder"
                        android:gravity="center"
                        android:text="📷 [Скриншот: экран записей объекта со списком]"
                        android:textColor="#888888"
                        android:textSize="14sp"
                        android:padding="16dp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ==================== СЕКЦИЯ 6: СОЗДАНИЕ ЗАПИСИ ==================== -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="?attr/cardBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="6. Создание и редактирование записи"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="?attr/textPrimaryColor"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="На экране записи вы заполняете поля и прикрепляете файлы.\n\nСтандартные поля (задаются в приветствии):\n\n• Заголовок — краткое название записи.\n• Содержимое — описание.\n\nДополнительные поля (до 10) — задаются в приветствии и настраиваются индивидуально для каждого типа. Подробнее — в разделе 7 «Типы полей».\n\nМедиафайлы:\n\n• Кнопка ➕ под меткой «Фото и видео» открывает выбор источника: «Сделать фото», «Записать видео», «Выбрать фото/видео», «Выбрать документ».\n• Крестик на миниатюре — удалить файл.\n• Нажатие на фото/видео — открыть на весь экран.\n\nСохранение: кнопка «Сохранить» внизу экрана. При сохранении проверяются обязательные поля — если что-то не заполнено, появится подсказка."
                        android:textSize="14sp"
                        android:textColor="?attr/textSecondaryColor"
                        android:lineSpacingExtra="4dp"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="180dp"
                        android:background="@drawable/bg_help_placeholder"
                        android:gravity="center"
                        android:text="📷 [Скриншот: экран создания записи с полями и медиа]"
                        android:textColor="#888888"
                        android:textSize="14sp"
                        android:padding="16dp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ==================== СЕКЦИЯ 7: ТИПЫ ПОЛЕЙ ==================== -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="?attr/cardBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="7. Типы полей"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="?attr/textPrimaryColor"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Приложение поддерживает 12 типов полей. Каждый тип меняет способ ввода и отображения. Доступны как для основных полей (Заголовок, Содержимое), так и для дополнительных.\n\n📝 Текст — обычная строка.\n\n🔢 Число — только цифры, поддерживает дробную часть.\n\n📅 Дата — выбор из календаря, формат «дд.мм.гггг».\n\n🕐 Дата и время — выбор даты и времени, формат «дд.мм.гггг чч:мм».\n\n☑️ Флажок (Да/Нет) — галочка вкл/выкл.\n\n📋 Выбор из списка — выпадающий список, можно выбрать только один вариант. Например, «Статус: Новый / В работе / Готово».\n\n✅ Множественный выбор — галочки, можно выбрать несколько вариантов. Например, «Теги: Важное, Срочное, Личное».\n\n🔗 Ссылка (URL) — специальная клавиатура для ввода интернет-адресов.\n\n📧 Email — клавиатура с @ и точкой.\n\n📞 Телефон — цифровая клавиатура.\n\n⭐ Рейтинг — звёзды от 1 до 5.\n\n📊 Прогресс — ползунок от 0 до 100%.\n\nДля полей типов «Выбор из списка» и «Множественный выбор» при настройке нужно ввести варианты через запятую.\n\nАвтозаполнение: для полей «Дата» и «Дата и время» можно включить чекбокс «Предзаполнять текущей датой/временем». Тогда при создании новой записи поле сразу заполнится текущим значением (его можно изменить). При редактировании существующей записи автозаполнение не срабатывает — сохраняется то, что было введено ранее."
                        android:textSize="14sp"
                        android:textColor="?attr/textSecondaryColor"
                        android:lineSpacingExtra="4dp"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="180dp"
                        android:background="@drawable/bg_help_placeholder"
                        android:gravity="center"
                        android:text="📷 [Скриншот: настройка дополнительных полей в приветствии]"
                        android:textColor="#888888"
                        android:textSize="14sp"
                        android:padding="16dp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ==================== СЕКЦИЯ 8: МЕДИА ==================== -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="?attr/cardBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="8. Работа с фото, видео и документами"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="?attr/textPrimaryColor"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="К каждой записи можно прикрепить неограниченное количество файлов.\n\nФото и видео:\n\n• Отображаются в виде сетки миниатюр под полями.\n• Нажатие — открыть галерею на весь экран.\n• В галерее: свайп влево/вправо для перехода между файлами, счётчик «X / Y» сверху.\n• Фото: можно увеличивать двумя пальцами, двойной тап — зум.\n• Долгое нажатие на фото — меню «Копировать фото в выбранную папку».\n• Видео: контролы play/pause, ±10 секунд, ползунок перемотки, громкость, скорость от 0.5x до 2x.\n• Контролы видео автоматически скрываются через 3 секунды бездействия.\n\nДокументы:\n\n• Отображаются списком под медиа-сеткой.\n• Поддерживаются PDF, DOC, DOCX, TXT и другие форматы.\n• Нажатие — открыть в приложении, которое может просматривать этот тип файла.\n• Крестик справа — удалить документ.\n\nВажно: при удалении записи все прикреплённые к ней файлы тоже удаляются с устройства."
                        android:textSize="14sp"
                        android:textColor="?attr/textSecondaryColor"
                        android:lineSpacingExtra="4dp"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="180dp"
                        android:background="@drawable/bg_help_placeholder"
                        android:gravity="center"
                        android:text="📷 [Скриншот: галерея с фото и видео на весь экран]"
                        android:textColor="#888888"
                        android:textSize="14sp"
                        android:padding="16dp"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="180dp"
                        android:background="@drawable/bg_help_placeholder"
                        android:gravity="center"
                        android:text="📷 [Скриншот: просмотр видео с контролами]"
                        android:textColor="#888888"
                        android:textSize="14sp"
