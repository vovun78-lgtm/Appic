<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Базовая тема -->
    <style name="AppTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar">

        <item name="android:windowFullscreen">false</item>
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowTranslucentNavigation">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>

        <!-- Единая тема диалогов для всего приложения (Шаг 1) -->
        <item name="materialAlertDialogTheme">@style/Appic_MaterialAlertDialog</item>

        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/purple_500</item>
        <item name="colorOnSecondary">@color/white</item>

        <item name="android:colorBackground">@color/bg_default</item>
        <item name="android:windowBackground">@color/bg_default</item>
        <item name="colorSurface">@color/card_default</item>
        <item name="colorOnSurface">@color/text_primary_default</item>
        <item name="colorOnBackground">@color/text_primary_default</item>

        <item name="cardBackground">@color/card_default</item>
        <item name="dividerColor">@color/divider_default</item>
        <item name="textPrimaryColor">@color/text_primary_default</item>
        <item name="textSecondaryColor">@color/text_secondary_default</item>
        <item name="popupBackgroundColor">@color/card_default</item>
        <item name="colorGroupBackground">@color/group_default</item>
        <item name="inputTextColor">@color/text_primary_default</item>
        <item name="fabColor">@color/purple_500</item>
        <item name="unreadDotColor">#F44336</item>

        <item name="android:popupMenuStyle">@style/MyPopupMenu</item>
        <item name="android:textAppearanceListItem">@style/TextAppearance.MyApp.SettingsTitle</item>
        <item name="android:colorControlActivated">@color/purple_500</item>
        <item name="android:colorControlNormal">@color/purple_700</item>
        <item name="android:colorAccent">@color/purple_500</item>
        <item name="buttonStyle">@style/ButtonPrimary</item>
        <item name="materialButtonStyle">@style/ButtonPrimary</item>
    </style>

