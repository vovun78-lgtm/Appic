    <!-- ============================================================
         ЕДИНАЯ ТЕМА ДИАЛОГОВ (Шаг 1)
         Применяется ко всем MaterialAlertDialogBuilder(context) через
         AppTheme.materialAlertDialogTheme → @style/Appic_MaterialAlertDialog.
         Автоматически наследует colorPrimary из активной цветовой схемы.
         ============================================================ -->
    <style name="Appic_MaterialAlertDialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Appic.Dialog</item>
    </style>

    <style name="ShapeAppearance.Appic.Dialog" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <style name="MyPopupMenu" parent="Widget.AppCompat.PopupMenu">
        <item name="android:textColorPrimary">?attr/textPrimaryColor</item>
        <item name="android:popupBackground">?attr/popupBackgroundColor</item>
    </style>

    <style name="PopupMenuDark" parent="ThemeOverlay.AppCompat.Dark">
        <item name="android:textColorPrimary">?attr/textPrimaryColor</item>
        <item name="android:popupBackground">?attr/popupBackgroundColor</item>
    </style>
</resources>